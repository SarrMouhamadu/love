# App
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://anonyme:anonymepropassword@localhost:5432/anonymepro?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT Secrets
JWT_SECRET=supersecret_jwt_key_change_in_production_anonymepro
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=supersecret_refresh_jwt_key_change_in_production
JWT_REFRESH_EXPIRES_IN=30d

# Storage (S3 / R2 / MinIO)
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=anonymepro-media
STORAGE_REGION=us-east-1

# Payment Providers (Sénégal - NabooPay pour Wave, Orange Money & CB)
NABOOPAY_API_KEY=
NABOOPAY_WEBHOOK_SECRET=
NABOOPAY_BASE_URL=https://api.naboopay.com
WAVE_API_KEY=
WAVE_API_SECRET=
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
